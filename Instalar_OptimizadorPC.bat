@echo off
echo Instalando Optimizador PC...
powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "$InstallerPath='%~f0'; $t=[IO.File]::ReadAllText($InstallerPath); $m='#PS'+'-INICIO#'; $e='#ZIP'+'-INICIO#'; $s=$t.IndexOf($m)+$m.Length; iex $t.Substring($s, $t.LastIndexOf($e)-$s)"
exit /b
#PS-INICIO#
# Instalador del Optimizador PC: el programa va incrustado al final de este archivo
$ErrorActionPreference = 'Stop'
Add-Type -AssemblyName PresentationFramework, System.Drawing, System.IO.Compression.FileSystem

function Say($text, $icon = 'Information', $buttons = 'OK') {
    [System.Windows.MessageBox]::Show($text, 'Instalar Optimizador PC', $buttons, $icon)
}

try {
    # Permisos de administrador (para actualizar el inicio automático y cerrar la versión abierta)
    $me = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
    if (-not $me.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
        Start-Process -FilePath $InstallerPath -Verb RunAs
        exit
    }

    $dest = Join-Path $env:LOCALAPPDATA 'Programs\OptimizadorPC'
    $mainScript = Join-Path $dest 'OptimizadorPC.ps1'
    $dataFiles = 'optimizador_ajustes.json', 'optimizador_respaldo.json'
    $oldFiles = 'OptimizadorPC.ps1', 'Iniciar.bat', 'Iniciar (diagnostico).bat'

    # 1. Buscar copias anteriores en las carpetas del usuario
    $roots = @(
        [Environment]::GetFolderPath('Desktop'), [Environment]::GetFolderPath('MyDocuments'),
        (Join-Path $env:USERPROFILE 'Downloads'), $env:OneDrive, $env:USERPROFILE
    ) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -Unique
    $found = @()
    foreach ($r in $roots) {
        $depth = if ($r -eq $env:USERPROFILE) { 3 } else { 6 }
        $found += Get-ChildItem -Path $r -Filter 'OptimizadorPC.ps1' -Recurse -Depth $depth -File -ErrorAction SilentlyContinue
    }
    $oldDirs = @($found | ForEach-Object { $_.DirectoryName } | Select-Object -Unique |
                 Where-Object { $_ -ne $dest -and $_ -notlike "$env:TEMP*" })

    # 2. Cerrar el optimizador si está abierto
    Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" |
        Where-Object { $_.CommandLine -match 'OptimizadorPC\.ps1' -and $_.ProcessId -ne $PID } |
        ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }

    # 3. Extraer el programa incrustado
    $text = [IO.File]::ReadAllText($InstallerPath)
    $marker = '#ZIP' + '-INICIO#'
    $b64 = $text.Substring($text.LastIndexOf($marker) + $marker.Length) -replace '[^A-Za-z0-9+/=]', ''
    $tmpZip = Join-Path $env:TEMP 'OptimizadorPC_instalar.zip'
    $tmpDir = Join-Path $env:TEMP 'OptimizadorPC_instalar'
    [IO.File]::WriteAllBytes($tmpZip, [Convert]::FromBase64String($b64))
    if (Test-Path $tmpDir) { Remove-Item $tmpDir -Recurse -Force }
    [IO.Compression.ZipFile]::ExtractToDirectory($tmpZip, $tmpDir)
    New-Item -ItemType Directory -Path $dest -Force | Out-Null
    Copy-Item -Path (Join-Path $tmpDir 'OptimizadorPC\*') -Destination $dest -Force
    Remove-Item $tmpZip, $tmpDir -Recurse -Force -ErrorAction SilentlyContinue

    # 4. Conservar ajustes, lista de juegos y el respaldo de valores originales
    $migrated = @()
    $sources = @($oldDirs | Sort-Object { (Get-Item (Join-Path $_ 'OptimizadorPC.ps1')).LastWriteTime } -Descending)
    foreach ($f in $dataFiles) {
        if (Test-Path (Join-Path $dest $f)) { continue }
        foreach ($d in $sources) {
            $src = Join-Path $d $f
            if (Test-Path $src) { Copy-Item $src (Join-Path $dest $f) -Force; $migrated += $f; break }
        }
    }

    # 5. Icono y accesos directos (escritorio y menú Inicio)
    $bmp = New-Object System.Drawing.Bitmap 32, 32
    $g = [System.Drawing.Graphics]::FromImage($bmp)
    $g.SmoothingMode = 'AntiAlias'
    $g.FillEllipse((New-Object System.Drawing.SolidBrush ([System.Drawing.Color]::FromArgb(118, 185, 0))), 1, 1, 30, 30)
    $pts = [System.Drawing.Point[]]@(
        (New-Object System.Drawing.Point 18, 4), (New-Object System.Drawing.Point 8, 18), (New-Object System.Drawing.Point 15, 18),
        (New-Object System.Drawing.Point 13, 28), (New-Object System.Drawing.Point 24, 13), (New-Object System.Drawing.Point 17, 13))
    $g.FillPolygon([System.Drawing.Brushes]::Black, $pts)
    $g.Dispose()
    $iconPath = Join-Path $dest 'icono.ico'
    $fs = [IO.File]::Create($iconPath)
    [System.Drawing.Icon]::FromHandle($bmp.GetHicon()).Save($fs)
    $fs.Close()

    $launchArgs = "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$mainScript`""
    $shell = New-Object -ComObject WScript.Shell
    $links = @(
        (Join-Path ([Environment]::GetFolderPath('Desktop')) 'Optimizador PC.lnk'),
        (Join-Path ([Environment]::GetFolderPath('Programs')) 'Optimizador PC.lnk')
    )
    foreach ($l in $links) {
        $sc = $shell.CreateShortcut($l)
        $sc.TargetPath = "$env:windir\System32\WindowsPowerShell\v1.0\powershell.exe"
        $sc.Arguments = $launchArgs
        $sc.WorkingDirectory = $dest
        $sc.IconLocation = $iconPath
        $sc.WindowStyle = 7
        $sc.Description = 'Optimizador PC'
        $sc.Save()
    }

    # 6. Si estaba activado "Iniciar con Windows", apuntarlo a la nueva ubicación
    $taskNote = ''
    if (Get-ScheduledTask -TaskName 'OptimizadorPC' -ErrorAction SilentlyContinue) {
        $action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument "$launchArgs -Minimized"
        Set-ScheduledTask -TaskName 'OptimizadorPC' -Action $action | Out-Null
        $taskNote = "`n- Inicio con Windows actualizado a la nueva ubicación."
    }

    # 7. Ofrecer borrar las copias viejas (solo los archivos del programa)
    $cleanNote = ''
    if ($oldDirs.Count) {
        $list = ($oldDirs | ForEach-Object { "   $_" }) -join "`n"
        $ans = Say ("Encontré copias anteriores del optimizador en:`n$list`n`nTus ajustes ya se copiaron a la nueva instalación.`n¿Borrar esas copias viejas?") 'Question' 'YesNo'
        if ($ans -eq 'Yes') {
            foreach ($d in $oldDirs) {
                foreach ($f in $oldFiles + $dataFiles) { Remove-Item (Join-Path $d $f) -Force -ErrorAction SilentlyContinue }
                if (-not (Get-ChildItem $d -Force -ErrorAction SilentlyContinue)) { Remove-Item $d -Force -ErrorAction SilentlyContinue }
            }
            $cleanNote = "`n- Copias viejas borradas."
        }
    }

    $oldNote = if ($oldDirs.Count) { "`n- Versión anterior encontrada en: $($oldDirs[0])" } else { "`n- No había versiones anteriores." }
    $migNote = if ($migrated.Count) { "`n- Ajustes conservados: $($migrated -join ', ')" } else { '' }
    Say ("¡Listo! Optimizador PC instalado en:`n$dest$oldNote$migNote$taskNote$cleanNote`n- Acceso directo en el escritorio y en el menú Inicio.`n`nSe abrirá ahora.") | Out-Null

    Start-Process -FilePath 'powershell.exe' -ArgumentList $launchArgs -WorkingDirectory $dest
} catch {
    Say "No se pudo completar la instalación:`n$($_.Exception.Message)" 'Error' | Out-Null
}
#ZIP-INICIO#

